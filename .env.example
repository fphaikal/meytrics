# Server Configuration
PORT=3000
NODE_ENV=production

# Security
# Generate a strong secret with: openssl rand -base64 32
JWT_SECRET=change-this-secret-in-production
# Initial admin password (only used on first run)
ADMIN_PASSWORD=admin

# Data Storage
# Directory for database and uploads. In Docker, this maps to the volume.
DATA_DIR=/data
# Database Connection String (PostgreSQL, MySQL, SQLite, etc.)
# Default: SQLite file in the data directory
DATABASE_URL="file:/data/monitor.db"

# File Uploads
# Max file size in MB (default: 5)
UPLOAD_LIMIT_MB=5

