generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  username   String   @unique
  password   String
  role       String   @default("admin")
  created_at DateTime @default(now())

  @@map("users")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  sort_order  Int       @default(0)
  created_at  DateTime  @default(now())
  services    Service[]

  @@map("categories")
}

model StatusPage {
  id               Int                 @id @default(autoincrement())
  slug             String              @unique
  name             String
  title            String?
  subtitle         String?
  navbar_title     String?
  logo_url         String?
  favicon_url      String?
  hero_bg_color    String?             @default("#1e2a38")
  primary_color    String?             @default("#3b82f6") // Blue-500
  secondary_color  String?             @default("#64748b") // Slate-500
  bg_color         String?             @default("#f8fafc") // Slate-50
  text_color       String?             @default("#0f172a") // Slate-900
  footer_bg_color  String?             @default("#ffffff")
  success_color    String?             @default("#22c55e") // Green-500
  warning_color    String?             @default("#eab308") // Yellow-500
  error_color      String?             @default("#ef4444") // Red-500
  theme_mode       String?             @default("system")
  bg_pattern       String?             @default("none")
  monitor_style    String?             @default("bars")
  meta_description String?
  og_image_url     String?
  custom_css       String?
  is_default       Int                 @default(0)
  is_public        Int                 @default(1)
  created_at       DateTime            @default(now())
  servicesRel      Service[]           @relation("StatusPageDefault")
  sections         StatusPageSection[]
  services         StatusPageService[]

  @@map("status_pages")
}

model StatusPageSection {
  id             Int                 @id @default(autoincrement())
  status_page_id Int
  name           String
  display_order  Int                 @default(0)
  created_at     DateTime            @default(now())
  statusPage     StatusPage          @relation(fields: [status_page_id], references: [id], onDelete: Cascade)
  services       StatusPageService[]

  @@map("status_page_sections")
}

model StatusPageService {
  status_page_id  Int
  service_id      Int
  section_id      Int?
  display_options String?            @default("{\"showHistory\":true,\"showChart\":true}")
  sort_order      Int                @default(0)
  section         StatusPageSection? @relation(fields: [section_id], references: [id])
  service         Service            @relation(fields: [service_id], references: [id], onDelete: Cascade)
  statusPage      StatusPage         @relation(fields: [status_page_id], references: [id], onDelete: Cascade)

  @@id([status_page_id, service_id])
  @@map("status_page_services")
}

model Service {
  id                     Int                  @id @default(autoincrement())
  name                   String
  url                    String
  type                   String?              @default("http")
  interval               Int                  @default(300)
  notify_down            Int                  @default(1)
  paused                 Int                  @default(0)
  category_id            Int?
  status_page_id         Int?
  ssl_expiry             DateTime?
  domain_expiry          DateTime?
  region                 String?              @default("North America")
  server_country         String?
  server_city            String?
  server_lat             Float?
  server_lon             Float?
  timeout                Int?                 @default(30)
  slow_threshold         Int?                 @default(1000)
  http_method            String?              @default("GET")
  custom_headers         String?              @default("{}")
  follow_redirects       Int?                 @default(1)
  auth_type              String?              @default("none")
  auth_user              String?
  auth_pass              String?
  notification_repeat    Int?                 @default(0)
  notification_delay     Int?                 @default(0)
  notify_ssl_expiry      Int?                 @default(0)
  notify_domain_expiry   Int?                 @default(0)
  ssl_expiry_threshold   String?              @default("7")
  domain_expiry_threshold String?              @default("14")
  keyword                String?
  keyword_condition      String?              @default("exists")
  keyword_case_sensitive Int?                 @default(0)
  dns_record_type        String?              @default("A")
  dns_expected_value     String?
  db_connection_string   String?
  db_query               String?
  created_at             DateTime             @default(now())
  alertHistory           AlertHistory[]
  incidentLinks          IncidentService[]
  maintenanceLinks       MaintenanceService[]
  pings                  Ping[]
  incidents              ServiceIncident[]
  tags                   ServiceTag[]
  statusPageDefault      StatusPage?          @relation("StatusPageDefault", fields: [status_page_id], references: [id])
  category               Category?            @relation(fields: [category_id], references: [id])
  statusOverrides        StatusOverride[]
  statusPageLinks        StatusPageService[]

  @@map("services")
}

model Ping {
  id            Int      @id @default(autoincrement())
  service_id    Int
  status        String
  response_time Int?
  status_code   Int?
  error         String?
  created_at    DateTime @default(now())
  service       Service  @relation(fields: [service_id], references: [id], onDelete: Cascade)

  @@index([service_id])
  @@index([created_at])
  @@index([service_id, created_at])
  @@index([created_at, status])
  @@map("pings")
}

model Incident {
  id          Int               @id @default(autoincrement())
  title       String
  description String?
  status      String?           @default("investigating")
  severity    String?           @default("minor")
  created_at  DateTime          @default(now())
  updated_at  DateTime?
  resolved_at DateTime?
  services    IncidentService[]
  updates     IncidentUpdate[]

  @@index([status])
  @@index([created_at])
  @@map("incidents")
}

model IncidentUpdate {
  id          Int      @id @default(autoincrement())
  incident_id Int
  message     String
  status      String?
  created_at  DateTime @default(now())
  incident    Incident @relation(fields: [incident_id], references: [id], onDelete: Cascade)

  @@map("incident_updates")
}

model IncidentService {
  incident_id Int
  service_id  Int
  service     Service  @relation(fields: [service_id], references: [id], onDelete: Cascade)
  incident    Incident @relation(fields: [incident_id], references: [id], onDelete: Cascade)

  @@id([incident_id, service_id])
  @@map("incident_services")
}

model ServiceIncident {
  id               Int       @id @default(autoincrement())
  service_id       Int
  status           String
  started_at       DateTime
  ended_at         DateTime?
  duration_seconds Int?
  error_message    String?
  created_at       DateTime  @default(now())
  service          Service   @relation(fields: [service_id], references: [id], onDelete: Cascade)

  @@map("service_incidents")
}

model Maintenance {
  id          Int                  @id @default(autoincrement())
  title       String
  description String?
  start_time  DateTime
  end_time    DateTime
  created_at  DateTime             @default(now())
  services    MaintenanceService[]

  @@map("maintenances")
}

model MaintenanceService {
  maintenance_id Int
  service_id     Int
  service        Service     @relation(fields: [service_id], references: [id], onDelete: Cascade)
  maintenance    Maintenance @relation(fields: [maintenance_id], references: [id], onDelete: Cascade)

  @@id([maintenance_id, service_id])
  @@map("maintenance_services")
}

model Subscriber {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  verified   Int      @default(0)
  token      String?
  created_at DateTime @default(now())

  @@map("subscribers")
}

model Webhook {
  id         Int      @id @default(autoincrement())
  name       String
  url        String
  type       String?  @default("custom")
  events     String?  @default("[\"down\",\"recovery\"]")
  headers    String?  @default("{}")
  enabled    Int      @default(1)
  config     String?  @default("{}")
  created_at DateTime @default(now())

  @@map("webhooks")
}

model AlertHistory {
  id         Int      @id @default(autoincrement())
  service_id Int?
  type       String?
  message    String?
  created_at DateTime @default(now())
  service    Service? @relation(fields: [service_id], references: [id])

  @@map("alert_history")
}

model ApiKey {
  id          Int       @id @default(autoincrement())
  name        String
  key         String    @unique
  permissions String?   @default("[\"read\"]")
  last_used   DateTime?
  enabled     Int       @default(1)
  created_at  DateTime  @default(now())

  @@map("api_keys")
}

model StatusOverride {
  id         Int      @id @default(autoincrement())
  service_id Int
  status     String
  reason     String?
  start_time DateTime
  end_time   DateTime
  created_at DateTime @default(now())
  service    Service  @relation(fields: [service_id], references: [id], onDelete: Cascade)

  @@map("status_overrides")
}

model Setting {
  key   String  @id
  value String?

  @@map("settings")
}

model Tag {
  id         Int          @id @default(autoincrement())
  name       String       @unique
  color      String?      @default("#6366f1")
  created_at DateTime     @default(now())
  services   ServiceTag[]

  @@map("tags")
}

model ServiceTag {
  service_id Int
  tag_id     Int
  tag        Tag     @relation(fields: [tag_id], references: [id], onDelete: Cascade)
  service    Service @relation(fields: [service_id], references: [id], onDelete: Cascade)

  @@id([service_id, tag_id])
  @@map("service_tags")
}
